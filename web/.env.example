# ---- Required ----
# Postgres connection string.
DATABASE_URL=postgres://workspace:workspace_dev_only@127.0.0.1:5434/workspace
# Public URL the app is served from (used in emails and cookie security).
APP_URL=http://localhost:3000
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me

# ---- Storage ----
# Directory for uploaded files. Must be outside the container image in production.
UPLOAD_DIR=./data/uploads
# Max upload size in megabytes.
MAX_UPLOAD_MB=25

# ---- Email (optional) ----
# If SMTP_HOST is empty, emails are not sent; admins copy invite/reset links from Settings instead.
# Google Workspace: smtp.gmail.com, port 465, the shared mailbox and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Team Workspace <workspace@example.com>"

# ---- Misc ----
LOG_LEVEL=info
