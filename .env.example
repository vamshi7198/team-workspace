# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Generate secrets with:  docker run --rm alpine sh -c "head -c 32 /dev/urandom | base64"

# Public address people use (the Cloudflare Tunnel hostname).
APP_URL=https://workspace.uncanned.in
APP_TIMEZONE=Asia/Kolkata

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Encrypts backup files. Store it in your password manager: without it backups can't be restored.
BACKUP_PASSPHRASE=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
CLOUDFLARE_TUNNEL_TOKEN=

# Email via the shared Google Workspace mailbox (optional; without it, admins copy links).
# Requires 2-Step Verification on that mailbox and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=workspace@uncanned.in
SMTP_PASSWORD=
MAIL_FROM="Uncanned Workspace <workspace@uncanned.in>"

# Off-site backup copy with rclone, e.g. "gdrive:team-workspace-backups" (optional).
RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2

# Local port for http://localhost (only reachable from this machine).
APP_PORT=3000
MAX_UPLOAD_MB=25
